<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Binder Probe" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".ManagerService"
            android:exported="false"
            android:process=":manager" />
        <service
            android:name=".WalkerService"
            android:exported="false"
            android:process=":walker" />
        <service
            android:name=".VictimService"
            android:exported="false"
            android:process=":victim" />
    </application>
</manifest>
