{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencrown.org/schema/payload-manifest.schema.json",
  "title": "Open Crown payload manifest",
  "description": "Signed descriptor for a payload bundle. See docs/04-payload-system.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "min_agent",
    "family",
    "targets",
    "capabilities",
    "entry",
    "agent",
    "persistence",
    "reversible",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "min_agent": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "family": {
      "type": "string",
      "enum": [
        "page-cache",
        "futex-uaf",
        "future"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "kernel_build",
          "abi",
          "android"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "kernel_build": {
            "type": "string",
            "minLength": 1
          },
          "abi": {
            "type": "string",
            "enum": [
              "arm64-v8a"
            ]
          },
          "android": {
            "type": "string",
            "pattern": "^(>=|<=|=)[0-9]{2}$"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "root",
          "domain",
          "controller",
          "shim",
          "diag"
        ]
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^files/"
    },
    "agent": {
      "type": "string",
      "pattern": "^files/"
    },
    "persistence": {
      "type": "string",
      "enum": [
        "boot"
      ]
    },
    "reversible": {
      "type": "string",
      "enum": [
        "reboot"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^files/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
