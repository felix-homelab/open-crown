{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencrown.org/schema/supported-devices.schema.json",
  "title": "Open Crown supported devices",
  "description": "The evidence-backed device list. See docs/04-payload-system.md section 8.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated",
    "devices"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "kernel_build",
          "abi",
          "android",
          "status"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "kernel_build": {
            "type": "string",
            "minLength": 1
          },
          "abi": {
            "type": "string",
            "enum": [
              "arm64-v8a"
            ]
          },
          "android": {
            "type": "string",
            "pattern": "^(>=|<=|=)[0-9]{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "example",
              "retired"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
